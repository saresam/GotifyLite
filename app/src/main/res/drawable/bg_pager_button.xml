<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F7F8FC" />
            <stroke android:width="1dp" android:color="#EDF0F5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6EAF3" />
            <stroke android:width="1dp" android:color="#D8DEEA" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_bg" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
